# Database Configuration
DATABASE_URL=postgresql://user:pass@host/db

# Authentication Keys (RS256 Private/Public Pair encoded in base64)
JWT_PRIVATE_KEY=       # RS256 private key (base64)
JWT_PUBLIC_KEY=        # RS256 public key (base64)

# Encryption Keys (32-byte hex string)
ENCRYPTION_KEY=        # 32-byte hex string

# Mono Connect (Open Banking Integration — GTBank, Access, Zenith, UBA, FirstBank, Providus, Sterling)
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_WEBHOOK_SECRET=

# Frontend (Vite) — Mono public key exposed to the browser
VITE_MONO_PUBLIC_KEY=

# Paystack Payment Gateway Integration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave Payment Gateway (collections & disbursements)
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=

# Moniepoint Business Banking API
MONIEPOINT_API_KEY=
MONIEPOINT_SECRET=
MONIEPOINT_BASE_URL=
MONIEPOINT_WEBHOOK_SECRET=

# App Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api

# Gemini AI Engine Verification (Injected by AI Studio)
GEMINI_API_KEY=
